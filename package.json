{
  "name": "estudo-facil",
  "version": "1.9.0",
  "description": "Estudo Fácil: plano de estudos para o concurso da ANPD, com questões no estilo Cebraspe, flashcards, revisões, sequência de dias e medalhas. App web instalável (PWA) do Projeto Fácil.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node comum/servidor.mjs",
    "test": "node --test --test-concurrency=1 --test-force-exit comum/testes/kit.test.mjs tests/*.test.mjs",
    "verificar": "node comum/verificar.mjs",
    "testar-regras": "node comum/testar-regras.mjs",
    "test:kit": "node comum/testar.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "pdfjs-dist": "3.11.174",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=22"
  }
}
